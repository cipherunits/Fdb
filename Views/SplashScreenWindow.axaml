<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fdb.ViewModels"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        x:Class="Fdb.Views.SplashScreenWindow"
        x:DataType="vm:SplashScreenViewModel"
        Title="Fdb Studio - Starting"
        Width="520" Height="320"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Topmost="True"
        ShowInTaskbar="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <!-- Modern Frameless Floating Splash Card with Deep Shadow -->
    <Border Margin="12"
            Background="#FFFFFF"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            CornerRadius="12"
            BoxShadow="0 12 36 0 #33000000"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto, *, Auto">
            
            <!-- Top Gradient Accent Strip -->
            <Border Grid.Row="0" Height="4" HorizontalAlignment="Stretch">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="#EA580C" Offset="0.0" />
                        <GradientStop Color="#F97316" Offset="0.4" />
                        <GradientStop Color="#2563EB" Offset="0.8" />
                        <GradientStop Color="#3B82F6" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Main Body Content -->
            <Grid Grid.Row="1" Margin="28,24,28,16" RowDefinitions="Auto, Auto, *">
                
                <!-- Logo & Title Header -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
                    <!-- Glowing Fire Flame Icon Badge -->
                    <Border Grid.Column="0" 
                            Width="54" Height="54" 
                            CornerRadius="12"
                            Background="#FFF7ED"
                            BorderBrush="#FED7AA"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <PathIcon Data="M12,2C12,2 10,5.5 10,8C10,9.5 11,10.5 12,11C13,10.5 14,9.5 14,8C14,5.5 12,2 12,2M12,13C9.5,13 6.5,15.5 6.5,18.5C6.5,21.5 9,24 12,24C15,24 17.5,21.5 17.5,18.5C17.5,15.5 14.5,13 12,13Z"
                                  Width="30" Height="30"
                                  Foreground="#EA580C"
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title & Tagline -->
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Fdb" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="#0F172A"/>
                            <TextBlock Text="Studio" 
                                       FontSize="24" 
                                       FontWeight="Light" 
                                       Foreground="#2563EB"/>
                            <Border Background="#EFF6FF" 
                                    BorderBrush="#BFDBFE" 
                                    BorderThickness="1" 
                                    CornerRadius="4" 
                                    Padding="6,2" 
                                    VerticalAlignment="Center"
                                    Margin="4,0,0,0">
                                <TextBlock Text="{Binding Version}" 
                                           FontSize="10" 
                                           FontWeight="SemiBold" 
                                           Foreground="#2563EB"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="High Performance SQL Database Management &amp; Analytics IDE" 
                                   FontSize="11" 
                                   Foreground="#64748B" 
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Feature Highlights Badges -->
                <WrapPanel Grid.Row="1" Margin="0,22,0,0" Orientation="Horizontal">
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,6">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ui:FASymbolIcon Symbol="Document" FontSize="11" Foreground="#2563EB" VerticalAlignment="Center"/>
                            <TextBlock Text="Multi-Tab SQL Editor" FontSize="11" Foreground="#334155"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,6">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ui:FASymbolIcon Symbol="Code" FontSize="11" Foreground="#2563EB" VerticalAlignment="Center"/>
                            <TextBlock Text="SQL IntelliSense" FontSize="11" Foreground="#334155"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,6">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ui:FASymbolIcon Symbol="Clock" FontSize="11" Foreground="#2563EB" VerticalAlignment="Center"/>
                            <TextBlock Text="Query Execution &amp; Export" FontSize="11" Foreground="#334155"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>

            <!-- Bottom Progress & Status Bar -->
            <Border Grid.Row="2" 
                    Background="#F8FAFC" 
                    BorderBrush="#E2E8F0" 
                    BorderThickness="0,1,0,0" 
                    Padding="28,14,28,16">
                <StackPanel Spacing="10">
                    <!-- Status Label & Percentage -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <ui:FASymbolIcon Symbol="Sync" FontSize="11" Foreground="#2563EB" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusText}" 
                                       FontSize="11" 
                                       Foreground="#475569" 
                                       FontWeight="Medium" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding ProgressValue, StringFormat='{}{0}%'}" 
                                   FontSize="11" 
                                   Foreground="#64748B" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Progress Bar (Smooth Accent Fill) -->
                    <ProgressBar Height="4" 
                                 CornerRadius="2" 
                                 Minimum="0" Maximum="100" 
                                 Value="{Binding ProgressValue}" 
                                 Foreground="#2563EB" 
                                 Background="#E2E8F0" 
                                 HorizontalAlignment="Stretch"/>

                    <!-- Footer Note -->
                    <Grid ColumnDefinitions="*, Auto" Margin="0,2,0,0">
                        <TextBlock Grid.Column="0" 
                                   Text="Connecting to local database engine..." 
                                   FontSize="10" 
                                   Foreground="#94A3B8"/>
                        <TextBlock Grid.Column="1" 
                                   Text="Click anywhere to skip" 
                                   FontSize="10" 
                                   Foreground="#94A3B8"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>