<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- Fdb Studio Design System: Componentized Light Theme Palette       -->
    <!-- Clean, high-contrast desktop aesthetic for daylight productivity  -->
    <!-- ================================================================= -->

    <!-- Base Palette Colors -->
    <Color x:Key="AppControlFaceColor">#F8FAFC</Color>
    <Color x:Key="AppWindowBackgroundColor">#FFFFFF</Color>
    <Color x:Key="AppWorkspaceColor">#FFFFFF</Color>
    <Color x:Key="AppBorderColor">#E2E8F0</Color>
    <Color x:Key="AppBorderLightColor">#F1F5F9</Color>
    <Color x:Key="AppBorderDarkColor">#CBD5E1</Color>
    <Color x:Key="AppTextPrimaryColor">#0F172A</Color>
    <Color x:Key="AppTextSecondaryColor">#475569</Color>
    <Color x:Key="AppTextMutedColor">#94A3B8</Color>
    <Color x:Key="AppAccentColor">#2563EB</Color>
    <Color x:Key="AppAccentHoverColor">#1D4ED8</Color>
    <Color x:Key="AppSplitterColor">#E2E8F0</Color>
    <Color x:Key="AppSplitterHoverColor">#3B82F6</Color>
    <Color x:Key="AppTabSelectedColor">#FFFFFF</Color>
    <Color x:Key="AppTabUnselectedColor">#F8FAFC</Color>
    <Color x:Key="AppTabHoverColor">#F1F5F9</Color>
    <Color x:Key="AppHeaderBgColor">#F8FAFC</Color>
    <Color x:Key="AppToolHoverBgColor">#F1F5F9</Color>
    <Color x:Key="AppToolHoverBorderColor">#CBD5E1</Color>

    <!-- Core Semantic Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppWorkspaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="AppControlFaceBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="AppSurfaceMutedBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="AppBorderLightBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AppBorderDarkBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#475569" />
    <SolidColorBrush x:Key="AppTextMutedBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AppSplitterBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="AppSplitterHoverBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AppTabActiveBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppTabInactiveBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="AppTabHoverBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AppTabActiveBorderBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AppEditorBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppEditorForegroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="AppToolHoverBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AppToolHoverBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="AppModalOverlayBrush" Color="#66000000" />
    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFF" />

    <!-- Table Component Semantic Brushes (QueryResultTable & SchemaPropertiesTable) -->
    <SolidColorBrush x:Key="AppTableGutterBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AppTableGutterForegroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="AppTableGutterBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="AppTableDividerBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="AppTableWhiteColBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppTableAltColBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="AppTableCellForegroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="AppTableCellBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="AppTableHeaderBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AppTableHeaderForegroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="AppTableHeaderBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="AppTableGridLinesHorizontalBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="AppTableGridLinesVerticalBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="AppTableSelectedBackgroundBrush" Color="#DBEAFE" />
    <SolidColorBrush x:Key="AppTableSelectedForegroundBrush" Color="#1E3A8A" />
    <SolidColorBrush x:Key="AppTableActiveBackgroundBrush" Color="#EFF6FF" />
    <SolidColorBrush x:Key="AppTableActiveForegroundBrush" Color="#1E3A8A" />
    <SolidColorBrush x:Key="AppTableActiveBorderBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AppTableHoverBackgroundBrush" Color="#F1F5F9" />

    <!-- IntelliSense & Overlay Component Semantic Brushes -->
    <SolidColorBrush x:Key="AppIntelliSenseHeaderBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="AppIntelliSenseBorderBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AppIntelliSenseBadgeBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AppIntelliSenseBadgeForegroundBrush" Color="#64748B" />

    <!-- SQL Syntax Keyword Color Token (Default: Light Mode Royal Blue) -->
    <SolidColorBrush x:Key="AppKeywordBrush" Color="#2563EB" />

</ResourceDictionary>
