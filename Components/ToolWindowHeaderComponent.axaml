<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="using:Fdb.Components"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Fdb.Components.ToolWindowHeaderComponent">
    
    <!-- Modern Reusable Tool Window Header -->
    <Border Background="{DynamicResource AppSurfaceBrush}" 
            BorderBrush="{DynamicResource AppBorderBrush}" 
            BorderThickness="0,0,0,1" 
            Height="26" 
            Padding="8,0">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Name="TitleText" 
                       Text="TOOL WINDOW" 
                       Foreground="{DynamicResource AppTextSecondaryBrush}" 
                       FontSize="10" 
                       FontWeight="Bold" 
                       LetterSpacing="0.6"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Name="CloseButton" 
                        Classes="classic-menu-btn" 
                        Command="{Binding $parent[components:ToolWindowHeaderComponent].CloseCommand}"
                        Padding="4,2" 
                        MinHeight="20" 
                        ToolTip.Tip="Close Panel">
                    <ui:FASymbolIcon Symbol="Dismiss" FontSize="9"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
