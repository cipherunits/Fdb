<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:vm="using:Fdb.ViewModels"
              xmlns:ui="using:FluentAvalonia.UI.Controls"
              mc:Ignorable="d" d:DesignWidth="240" d:DesignHeight="300"
              x:Class="Fdb.Components.ObjectExplorerEmptyStateComponent">

    <!-- Reusable Object Explorer Empty State Card (Shown when disconnected) -->
    <Border Background="{DynamicResource AppWorkspaceBrush}" 
            BorderBrush="{DynamicResource AppBorderBrush}" 
            BorderThickness="1" 
            CornerRadius="4" 
            Margin="6">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="16">
            <ui:FASymbolIcon Symbol="Folder" FontSize="32" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="No Active Connection" 
                       Foreground="{DynamicResource AppTextSecondaryBrush}" 
                       FontSize="11" 
                       FontWeight="SemiBold" 
                       HorizontalAlignment="Center" 
                       TextAlignment="Center"/>
            <Button Classes="classic-tool-btn" 
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ConnectModal.OpenCommand}" 
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:FASymbolIcon Symbol="Link" FontSize="11" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Connect..." VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
