<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:vm="using:Fdb.ViewModels"
              xmlns:ui="using:FluentAvalonia.UI.Controls"
              mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="180"
              x:Class="Fdb.Components.ThemeSelectionCardsComponent"
              x:DataType="vm:SettingsModalViewModel">

    <UserControl.Styles>
        <Style Selector="Border.theme-card">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.theme-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
        </Style>
        <Style Selector="Border.theme-card.active">
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppTabHoverBackgroundBrush}"/>
        </Style>
    </UserControl.Styles>

    <!-- Reusable Workspace Theme Selection Cards Component -->
    <StackPanel Spacing="6">
        <TextBlock Text="WORKSPACE THEME" 
                   FontSize="11" 
                   FontWeight="Bold" 
                   Foreground="{DynamicResource AppTextMutedBrush}"/>

        <Grid RowDefinitions="Auto, Auto, Auto" Margin="0,2">
            <!-- Option 1: Light Theme -->
            <Border Grid.Row="0" 
                    Classes="theme-card"
                    Classes.active="{Binding IsLightTheme}"
                    PointerPressed="OnLightCardPointerPressed"
                    Padding="12,10" 
                    Margin="0,0,0,8">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <!-- Mini Preview Swatch -->
                    <Border Grid.Column="0" 
                            Width="44" 
                            Height="30" 
                            Background="#FFFFFF" 
                            BorderBrush="#CBD5E1" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Margin="0,0,12,0">
                        <Border Height="8" 
                                VerticalAlignment="Top" 
                                Background="#2563EB" 
                                CornerRadius="3,3,0,0"/>
                    </Border>

                    <!-- Text Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Light Theme" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        <TextBlock Text="Clean, bright desktop workspace with high contrast readability." 
                                   FontSize="11" 
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Selection Indicator Icon -->
                    <Border Grid.Column="2" 
                            Width="20" 
                            Height="20" 
                            CornerRadius="10" 
                            Background="{DynamicResource AppAccentBrush}" 
                            IsVisible="{Binding IsLightTheme}" 
                            VerticalAlignment="Center">
                        <ui:FASymbolIcon Symbol="Checkmark" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Option 2: Dark Theme -->
            <Border Grid.Row="1" 
                    Classes="theme-card"
                    Classes.active="{Binding IsDarkTheme}"
                    PointerPressed="OnDarkCardPointerPressed"
                    Padding="12,10" 
                    Margin="0,0,0,8">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <!-- Mini Preview Swatch -->
                    <Border Grid.Column="0" 
                            Width="44" 
                            Height="30" 
                            Background="#0F172A" 
                            BorderBrush="#334155" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Margin="0,0,12,0">
                        <Border Height="8" 
                                VerticalAlignment="Top" 
                                Background="#3B82F6" 
                                CornerRadius="3,3,0,0"/>
                    </Border>

                    <!-- Text Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Dark Theme" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        <TextBlock Text="Modern dark mode workspace for low-light focus and reduced eye fatigue." 
                                   FontSize="11" 
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Selection Indicator Icon -->
                    <Border Grid.Column="2" 
                            Width="20" 
                            Height="20" 
                            CornerRadius="10" 
                            Background="{DynamicResource AppAccentBrush}" 
                            IsVisible="{Binding IsDarkTheme}" 
                            VerticalAlignment="Center">
                        <ui:FASymbolIcon Symbol="Checkmark" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Option 3: System Theme (Default) -->
            <Border Grid.Row="2" 
                    Classes="theme-card"
                    Classes.active="{Binding IsSystemTheme}"
                    PointerPressed="OnSystemCardPointerPressed"
                    Padding="12,10">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <!-- Mini Preview Swatch (Split half light / half dark) -->
                    <Grid Grid.Column="0" 
                          Width="44" 
                          Height="30" 
                          Margin="0,0,12,0">
                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                            <Grid ColumnDefinitions="*, *">
                                <Border Grid.Column="1" Background="#0F172A" CornerRadius="0,3,3,0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Text Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="System Theme (Sync with OS)" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        <TextBlock Text="Automatically adapt theme based on your Windows appearance settings." 
                                   FontSize="11" 
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Selection Indicator Icon -->
                    <Border Grid.Column="2" 
                            Width="20" 
                            Height="20" 
                            CornerRadius="10" 
                            Background="{DynamicResource AppAccentBrush}" 
                            IsVisible="{Binding IsSystemTheme}" 
                            VerticalAlignment="Center">
                        <ui:FASymbolIcon Symbol="Checkmark" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
