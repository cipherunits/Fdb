<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:vm="using:Fdb.ViewModels"
              xmlns:ui="using:FluentAvalonia.UI.Controls"
              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="32"
              x:Class="Fdb.Components.EditorTabStripComponent"
              x:DataType="vm:EditorViewModel">

    <UserControl.Styles>
        <!-- Active Tab Container Styling -->
        <Style Selector="Border.editor-tab.active">
            <Setter Property="Background" Value="{DynamicResource AppTabActiveBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        </Style>
        <Style Selector="Border.editor-tab:not(.active)">
            <Setter Property="Background" Value="{DynamicResource AppTabInactiveBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        </Style>
        <Style Selector="Border.editor-tab:not(.active):pointerover">
            <Setter Property="Background" Value="{DynamicResource AppTabHoverBackgroundBrush}"/>
        </Style>

        <!-- Active Tab Title Color & Weight -->
        <Style Selector="Border.editor-tab.active TextBlock.tab-title">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.editor-tab:not(.active) TextBlock.tab-title">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- Active Tab Icon -->
        <Style Selector="Border.editor-tab.active ui|FASymbolIcon.tab-icon">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="Border.editor-tab:not(.active) ui|FASymbolIcon.tab-icon">
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
        </Style>
    </UserControl.Styles>

    <!-- Auto-Expanding Document Tabs Strip Component -->
    <Border Background="{DynamicResource AppSurfaceBrush}" 
            BorderBrush="{DynamicResource AppBorderBrush}" 
            BorderThickness="0,0,0,1" 
            Padding="4,4,4,0">
        <Grid ColumnDefinitions="*, Auto">
            <!-- Tabs automatically expand and take full available width via UniformGrid -->
            <ItemsControl Grid.Column="0" ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Clickable Tab Container -->
                        <Border Classes="editor-tab"
                                Classes.active="{Binding IsActive}"
                                BorderThickness="1,1,1,0" 
                                CornerRadius="4,4,0,0" 
                                Margin="1,0" 
                                HorizontalAlignment="Stretch"
                                PointerPressed="OnTabPointerPressed"
                                Cursor="Hand">
                            <!-- Right-Click Context Menu -->
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Close" 
                                              Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).CloseTabCommand}" 
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Close Others" 
                                              Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).CloseOtherTabsCommand}" 
                                              CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="Close All" 
                                              Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).CloseAllTabsCommand}" />
                                </ContextMenu>
                            </Border.ContextMenu>

                            <Grid RowDefinitions="Auto, *">
                                <!-- Dynamic Accent Indicator Strip at Top of Active Tab -->
                                <Border Grid.Row="0" 
                                        Height="2.5" 
                                        Background="{DynamicResource AppAccentBrush}" 
                                        IsVisible="{Binding IsActive}" 
                                        HorizontalAlignment="Stretch"/>

                                <!-- Tab Header Body -->
                                <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto" Margin="8,5">
                                    <!-- Document Icon -->
                                    <ui:FASymbolIcon Grid.Column="0" 
                                                     Classes="tab-icon"
                                                     Symbol="Document" 
                                                     FontSize="11" 
                                                     Margin="0,0,6,0" 
                                                     VerticalAlignment="Center"/>

                                    <!-- Tab Title -->
                                    <TextBlock Grid.Column="1" 
                                               Classes="tab-title"
                                               Text="{Binding Title}" 
                                               FontSize="11" 
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Close Button -->
                                    <Button Grid.Column="2" 
                                            Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).CloseTabCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="classic-menu-btn" 
                                            Padding="4,2" 
                                            MinHeight="14"
                                            Margin="4,0,0,0">
                                        <ui:FASymbolIcon Symbol="Dismiss" FontSize="8"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Add Tab Button -->
            <Button Grid.Column="1" 
                    Command="{Binding AddTabCommand}" 
                    Classes="classic-menu-btn" 
                    Padding="8,4" 
                    MinHeight="24"
                    Margin="4,0,0,0"
                    ToolTip.Tip="New SQL Query Tab (Ctrl+N)">
                <ui:FASymbolIcon Symbol="Add" FontSize="11"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
