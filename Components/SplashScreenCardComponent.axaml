<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:vm="using:Fdb.ViewModels"
              xmlns:ui="using:FluentAvalonia.UI.Controls"
              mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="400"
              x:Class="Fdb.Components.SplashScreenCardComponent"
              x:DataType="vm:SplashScreenViewModel">

    <!-- Reusable Frameless Splash Screen Card Component (Artwork + Real-time SQLite Loading Indicator) -->
    <Border Margin="16"
            CornerRadius="12"
            ClipToBounds="True"
            BoxShadow="0 16 40 0 #66000000">
        <Grid>
            <!-- Background Splash Artwork -->
            <Image Source="avares://Fdb/Assets/Images/splash_screen.jpg"
                   Stretch="UniformToFill"
                   RenderOptions.BitmapInterpolationMode="HighQuality"/>

            <!-- Progress & Status Bottom Bar Overlay -->
            <Border VerticalAlignment="Bottom"
                    Background="#B30B0F14"
                    Padding="24,14,24,16">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <ui:FASymbolIcon Symbol="Sync" FontSize="11" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="11"
                                       Foreground="#E2E8F0"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ProgressValue, StringFormat='{}{0}%'}"
                                   FontSize="11"
                                   Foreground="#CBD5E1"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <ProgressBar Height="4"
                                 CornerRadius="2"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ProgressValue}"
                                 Foreground="#E8943A"
                                 Background="#33FFFFFF"
                                 HorizontalAlignment="Stretch"/>

                    <Grid ColumnDefinitions="*, Auto" Margin="0,2,0,0">
                        <TextBlock Grid.Column="0"
                                   Text="Connecting to local database engine..."
                                   FontSize="10"
                                   Foreground="#94A3B8"/>
                        <TextBlock Grid.Column="1"
                                   Text="Click anywhere to skip"
                                   FontSize="10"
                                   Foreground="#94A3B8"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
