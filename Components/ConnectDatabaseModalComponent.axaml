<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Fdb.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Fdb.Components.ConnectDatabaseModalComponent"
             x:DataType="vm:ConnectDatabaseModalViewModel"
             IsVisible="{Binding IsOpen}">

    <!-- Database Connection Modal Dialog -->
    <Grid>
        <!-- Backdrop (Click to dismiss) -->
        <Border Background="#660F172A" PointerPressed="OnBackdropPointerPressed" />

        <!-- Centered Dialog Window Card -->
        <Border Background="{DynamicResource AppWorkspaceBrush}" 
                BorderBrush="{DynamicResource AppBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                BoxShadow="0 10 25 0 #33000000"
                Width="480"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
            
            <Grid RowDefinitions="Auto, *, Auto">
                
                <!-- 1. Header -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource AppSurfaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        CornerRadius="8,8,0,0"
                        Padding="16,12">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" 
                                Background="{DynamicResource AppAccentBrush}" 
                                CornerRadius="6" 
                                Width="28" 
                                Height="28" 
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Link" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Connect to Database" 
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                       FontSize="13" 
                                       FontWeight="Bold"/>
                            <TextBlock Text="Configure SQL Server instance connection" 
                                       Foreground="{DynamicResource AppTextMutedBrush}" 
                                       FontSize="11" 
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" 
                                Classes="classic-menu-btn" 
                                Command="{Binding CloseCommand}"
                                Padding="6,2" 
                                MinHeight="22">
                            <ui:FASymbolIcon Symbol="Dismiss" FontSize="10"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Form Body -->
                <StackPanel Grid.Row="1" Margin="20,16" Spacing="12">
                    <!-- Server & Port -->
                    <Grid ColumnDefinitions="*, 12, 100">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Server Host / IP" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            <TextBox Text="{Binding Server}" Height="30" FontSize="12" CornerRadius="4" Padding="8,4" PlaceholderText="localhost"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Port" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            <TextBox Text="{Binding Port}" Height="30" FontSize="12" CornerRadius="4" Padding="8,4" PlaceholderText="1433"/>
                        </StackPanel>
                    </Grid>

                    <!-- Database -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Initial Database" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        <TextBox Text="{Binding Database}" Height="30" FontSize="12" CornerRadius="4" Padding="8,4" PlaceholderText="master"/>
                    </StackPanel>

                    <!-- Authentication Method -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Authentication" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        <ComboBox ItemsSource="{Binding AuthTypes}" SelectedItem="{Binding AuthType}" HorizontalAlignment="Stretch" Height="30" CornerRadius="4" FontSize="12" />
                    </StackPanel>

                    <!-- Username & Password -->
                    <Grid ColumnDefinitions="*, 12, *">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Username" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            <TextBox Text="{Binding Username}" Height="30" FontSize="12" CornerRadius="4" Padding="8,4" PlaceholderText="sa"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Password" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            <TextBox Text="{Binding Password}" PasswordChar="*" Height="30" FontSize="12" CornerRadius="4" Padding="8,4"/>
                        </StackPanel>
                    </Grid>

                    <!-- Options -->
                    <CheckBox IsChecked="{Binding TrustServerCertificate}" 
                              Content="Trust Server Certificate (Encryption)" 
                              FontSize="11" 
                              Foreground="{DynamicResource AppTextSecondaryBrush}" 
                              Margin="0,4,0,0"/>

                    <!-- Status Message Alert (If any) -->
                    <Border Background="#ECFDF5" 
                            BorderBrush="#A7F3D0" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Padding="10,6" 
                            IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding StatusMessage}" 
                                   Foreground="#065F46" 
                                   FontSize="11"/>
                    </Border>
                </StackPanel>

                <!-- 3. Footer -->
                <Border Grid.Row="2" 
                        Background="{DynamicResource AppSurfaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,1,0,0" 
                        CornerRadius="0,0,8,8"
                        Padding="16,10">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Button Grid.Column="0" 
                                Classes="classic-tool-btn" 
                                Command="{Binding TestConnectionCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:FASymbolIcon Symbol="Sync" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="Test Connection" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button Classes="classic-tool-btn" 
                                    Content="Cancel" 
                                    Command="{Binding CloseCommand}"/>

                            <Button Background="{DynamicResource AppAccentBrush}" 
                                    Foreground="White" 
                                    FontWeight="SemiBold" 
                                    FontSize="11" 
                                    CornerRadius="4" 
                                    Padding="16,6"
                                    Content="Connect" 
                                    Command="{Binding ConnectCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
