<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Fdb.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="54"
             x:Class="Fdb.Components.NavbarComponent"
             x:DataType="vm:NavbarViewModel">

    <!-- Modern Desktop Navbar with Native MenuBar & Window/Workspace Menu -->
    <Border Background="{DynamicResource AppBackgroundBrush}" 
            BorderBrush="{DynamicResource AppBorderBrush}" 
            BorderThickness="0,0,0,1">
        <StackPanel Orientation="Vertical">
            
            <!-- 1. Native MenuBar (File, Edit, View, Window/Workspace, Help) -->
            <Border Background="{DynamicResource AppBackgroundBrush}" 
                    BorderBrush="{DynamicResource AppBorderLightBrush}" 
                    BorderThickness="0,0,0,1" 
                    Height="26" 
                    Padding="6,0">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <!-- Brand Icon/Title + Menu -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <!-- Vector Database / Engine Icon -->
                        <Border Background="{DynamicResource AppAccentBrush}" CornerRadius="4" Width="18" Height="18" Margin="0,0,6,0">
                            <PathIcon Data="M12,2C10.5,5 8.5,7 8.5,10A3.5,3.5 0 0,0 12,13.5A3.5,3.5 0 0,0 15.5,10C15.5,7 13.5,5 12,2M12,4.5C12.8,6.2 13.5,7.7 13.5,10A1.5,1.5 0 0,1 12,11.5A1.5,1.5 0 0,1 10.5,10C10.5,7.7 11.2,6.2 12,4.5Z" 
                                      Width="11" Height="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Title}" 
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                   FontWeight="Bold" 
                                   FontSize="12" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,10,0"/>

                        <!-- Native Menu Dropdown System -->
                        <Menu Background="Transparent">
                            <!-- File Menu -->
                            <MenuItem Header="File">
                                <MenuItem Header="Connect to Database..." 
                                          InputGesture="Ctrl+Shift+C"
                                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ConnectModal.OpenCommand}" />
                                <MenuItem Header="Export Results to File..." 
                                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ExportModal.OpenCommand}" />
                                <Separator />
                                <MenuItem Header="New Query" 
                                          InputGesture="Ctrl+N" 
                                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Editor.AddTabCommand}" />
                                <MenuItem Header="Save" 
                                          InputGesture="Ctrl+S" 
                                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SaveQueryCommand}" />
                                <Separator />
                                <MenuItem Header="Settings..." 
                                          InputGesture="Ctrl+," 
                                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SettingsModal.OpenCommand}" />
                                <Separator />
                                <MenuItem Header="Exit" 
                                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ExitCommand}" />
                            </MenuItem>

                            <!-- Edit Menu -->
                            <MenuItem Header="Edit">
                                <MenuItem Header="Undo" InputGesture="Ctrl+Z" />
                                <MenuItem Header="Redo" InputGesture="Ctrl+Y" />
                                <Separator />
                                <MenuItem Header="Cut" InputGesture="Ctrl+X" />
                                <MenuItem Header="Copy" InputGesture="Ctrl+C" />
                                <MenuItem Header="Paste" InputGesture="Ctrl+V" />
                            </MenuItem>

                            <!-- View Menu -->
                            <MenuItem Header="View">
                                <MenuItem Header="Object Explorer (Sidebar)" 
                                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleSidebarCommand}" />
                                <MenuItem Header="Output &amp; Results (Footer)" 
                                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleFooterCommand}" />
                            </MenuItem>

                            <!-- Window / Workspace Menu (Restore Tabs & Panels) -->
                            <MenuItem Header="Window">
                                <MenuItem Header="Show Object Explorer" 
                                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowSidebarCommand}" />
                                <MenuItem Header="Show Output &amp; Results" 
                                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowFooterCommand}" />
                                <Separator />
                                <MenuItem Header="Restore Footer Tabs">
                                    <MenuItem Header="Terminal" 
                                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RestoreFooterTabCommand}" 
                                              CommandParameter="Terminal" />
                                    <MenuItem Header="Output" 
                                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RestoreFooterTabCommand}" 
                                              CommandParameter="Output" />
                                    <MenuItem Header="Problems" 
                                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RestoreFooterTabCommand}" 
                                              CommandParameter="Problems" />
                                </MenuItem>
                                <MenuItem Header="Restore Sidebar Tabs">
                                    <MenuItem Header="Explorer" 
                                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RestoreSidebarTabCommand}" 
                                              CommandParameter="Explorer" />
                                    <MenuItem Header="Databases" 
                                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RestoreSidebarTabCommand}" 
                                              CommandParameter="Databases" />
                                    <MenuItem Header="History" 
                                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RestoreSidebarTabCommand}" 
                                              CommandParameter="History" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Reset Window Layout" 
                                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ResetLayoutCommand}" />
                            </MenuItem>

                            <!-- Help Menu -->
                            <MenuItem Header="Help">
                                <MenuItem Header="Documentation" />
                                <MenuItem Header="About Fdb Studio" />
                            </MenuItem>
                        </Menu>
                    </StackPanel>

                    <!-- Right Info / Status -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,6,0">
                        <!-- Connection Status Pill -->
                        <Border Background="{DynamicResource AppSurfaceBrush}" 
                                BorderBrush="{DynamicResource AppBorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Padding="8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center"/>
                                <TextBlock Text="master [localhost:1433]" 
                                           Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                           FontSize="11" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Standard Toolbar Row -->
            <Border Background="{DynamicResource AppSurfaceBrush}" Height="28" Padding="6,2">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Background="{DynamicResource AppAccentBrush}" 
                            Foreground="White" 
                            FontWeight="SemiBold" 
                            FontSize="11" 
                            CornerRadius="4" 
                            Padding="10,4"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ExecuteQueryCommand}"
                            ToolTip.Tip="Execute active SQL query (F5)">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ui:FASymbolIcon Symbol="Play" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="Run (F5)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="classic-tool-btn"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Editor.AddTabCommand}"
                            ToolTip.Tip="Open New Query Tab (Ctrl+N)">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ui:FASymbolIcon Symbol="Add" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="New Query" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="classic-tool-btn"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SaveQueryCommand}"
                            ToolTip.Tip="Save Query to SQLite Storage (Ctrl+S)">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ui:FASymbolIcon Symbol="Save" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="Save" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Height="16" Background="{DynamicResource AppBorderBrush}" Margin="4,0"/>

                    <Button x:Name="ConnectButton"
                            Classes="classic-tool-btn" 
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ConnectModal.OpenCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ui:FASymbolIcon Symbol="Link" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="Connect..." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="classic-tool-btn"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DisconnectCommand}"
                            ToolTip.Tip="Disconnect from active database session">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ui:FASymbolIcon Symbol="Dismiss" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="Disconnect" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
