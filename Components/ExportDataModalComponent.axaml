<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Fdb.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Fdb.Components.ExportDataModalComponent"
             x:DataType="vm:ExportDataModalViewModel"
             IsVisible="{Binding IsOpen}">

    <!-- Reusable Data Export Modal Dialog -->
    <Grid>
        <!-- Backdrop (Click to dismiss) -->
        <Border Background="#660F172A" PointerPressed="OnBackdropPointerPressed" />

        <!-- Centered Dialog Window Card -->
        <Border Background="{DynamicResource AppWorkspaceBrush}" 
                BorderBrush="{DynamicResource AppBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                BoxShadow="0 10 25 0 #33000000"
                Width="460"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
            
            <Grid RowDefinitions="Auto, *, Auto">
                
                <!-- 1. Header -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource AppSurfaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        CornerRadius="8,8,0,0"
                        Padding="16,12">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" 
                                Background="{DynamicResource AppAccentBrush}" 
                                CornerRadius="6" 
                                Width="28" 
                                Height="28" 
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Download" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Export Data" 
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                       FontSize="13" 
                                       FontWeight="Bold"/>
                            <TextBlock Text="Save query results or table rows to disk" 
                                       Foreground="{DynamicResource AppTextMutedBrush}" 
                                       FontSize="11" 
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" 
                                Classes="classic-menu-btn" 
                                Command="{Binding CloseCommand}"
                                Padding="6,2" 
                                MinHeight="22">
                            <ui:FASymbolIcon Symbol="Dismiss" FontSize="10"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Form Body -->
                <StackPanel Grid.Row="1" Margin="20,16" Spacing="12">
                    <!-- Export Format -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Export Format" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        <ComboBox ItemsSource="{Binding ExportFormats}" SelectedItem="{Binding SelectedFormat}" HorizontalAlignment="Stretch" Height="30" CornerRadius="4" FontSize="12" />
                    </StackPanel>

                    <!-- Destination File Path -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Destination File Path" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        <Grid ColumnDefinitions="*, 8, Auto">
                            <TextBox Grid.Column="0" Text="{Binding FilePath}" Height="30" FontSize="12" CornerRadius="4" Padding="8,4"/>
                            <Button Grid.Column="2" 
                                    Classes="classic-tool-btn" 
                                    Content="Browse..." 
                                    Height="30"
                                    Command="{Binding BrowseFileCommand}"
                                    CommandParameter="{Binding $parent[TopLevel]}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Checkboxes -->
                    <StackPanel Spacing="6" Margin="0,4,0,0">
                        <CheckBox IsChecked="{Binding IncludeHeaders}" 
                                  Content="Include column headers in export" 
                                  FontSize="11" 
                                  Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 3. Footer -->
                <Border Grid.Row="2" 
                        Background="{DynamicResource AppSurfaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,1,0,0" 
                        CornerRadius="0,0,8,8"
                        Padding="16,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="classic-tool-btn" 
                                Content="Cancel" 
                                Command="{Binding CloseCommand}"/>

                        <Button Background="{DynamicResource AppAccentBrush}" 
                                Foreground="White" 
                                FontWeight="SemiBold" 
                                FontSize="11" 
                                CornerRadius="4" 
                                Padding="16,6"
                                Command="{Binding ExportCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:FASymbolIcon Symbol="Download" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="Export Data" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
