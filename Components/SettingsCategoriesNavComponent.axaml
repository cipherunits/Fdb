<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:vm="using:Fdb.ViewModels"
              xmlns:ui="using:FluentAvalonia.UI.Controls"
              mc:Ignorable="d" d:DesignWidth="190" d:DesignHeight="400"
              x:Class="Fdb.Components.SettingsCategoriesNavComponent"
              x:DataType="vm:SettingsModalViewModel">

    <!-- Reusable Categories Navigation Sidebar Component for Settings Dialog -->
    <Border Background="{DynamicResource AppSurfaceMutedBrush}" 
            BorderBrush="{DynamicResource AppBorderBrush}" 
            BorderThickness="0,0,1,0" 
            Padding="8,12">
        <StackPanel Spacing="4">
            <TextBlock Text="CATEGORIES" 
                       FontSize="10" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource AppTextMutedBrush}" 
                       Margin="8,0,0,6"/>

            <!-- Active Category Item: Appearance -->
            <Border Background="{DynamicResource AppTabActiveBackgroundBrush}" 
                    BorderBrush="{DynamicResource AppAccentBrush}" 
                    BorderThickness="2,0,0,0" 
                    CornerRadius="0,4,4,0" 
                    Padding="10,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:FASymbolIcon Symbol="Settings" FontSize="13" Foreground="{DynamicResource AppAccentBrush}"/>
                    <TextBlock Text="Appearance" 
                               FontSize="12" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource AppAccentBrush}"/>
                </StackPanel>
            </Border>

            <!-- Future Extensible Categories (Placeholder badges) -->
            <Border Background="Transparent" Padding="10,8" Opacity="0.6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:FASymbolIcon Symbol="Document" FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBlock Text="Editor (General)" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Background="Transparent" Padding="10,8" Opacity="0.6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:FASymbolIcon Symbol="Keyboard" FontSize="13" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBlock Text="Shortcuts" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
